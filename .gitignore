# Build artifacts
/target
# The compute-host parity runners are their own cargo projects (they need
# the `runtime-onnx-dynamic` feature, which the workspace default build
# must not carry); their target dirs are build output like any other.
/benchmarks/validation/runner/*/target
# wasm-pack output (§57): rebuilt by `just check-wasm`, never committed
/crates/opencodifier-wasm/pkg

# Release staging (`just release-matrix`, `just release-notes`): matrix
# artifacts, their attestations, and the rendered release notes. Uploads ride
# the GitForge release; this tree is regenerated, never committed.
/dist

# Coverage output
/coverage
*.profraw
*.profdata
tarpaulin-report.html
lcov.info

# Model artifacts are never committed (downloaded explicitly, SHA-256 verified)
/models/**/*.onnx
/models/**/*.safetensors
/models/**/*.gguf

# Local scratch state
/.scratch
*.local.toml

# Benchmark runtime logs and raw run JSONs are out-of-tree measurement data;
# the repo commits only results/summary.md + results/models.manifest.json
/benchmarks/decision-model/results/*.server.log
/benchmarks/decision-model/results/*.json
!/benchmarks/decision-model/results/models.manifest.json

# Editor / OS noise
.idea/
.vscode/
*.swp
*~
.DS_Store

# Python bytecode (benchmark runners)
__pycache__/

# Derived benchmark data: regenerated byte-identically by
# benchmarks/decision-model/runner/make_long_suite.py before the
# long-context A/B runs (REPORT.md "Long-context A/B") and by
# runner/shuffle_suite.py before the shuffled-context OOD probe
# (BENCHMARKS.md "Shuffled-context OOD probe").
benchmarks/decision-model/suite/suite_long.json
benchmarks/decision-model/suite/suite_shuffled.json
.wrangler/
